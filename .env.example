NODE_ENV=development
HOST=127.0.0.1
PORT=8787
WORKER_HOST=127.0.0.1
WORKER_PORT=47821
PUBLIC_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

SESSION_SECRET=replace-with-long-random-string
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
ALLOW_REGISTER=true

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# Java 8 is required for legacy KEmulator nnx64 only.
# Runtime chinh la KEmulator Lite 0.9.8 + JRE 1.4.2 kem theo (xem .env).
RUNTIME_TYPE=kemulator-0.9.8
JAVA_BIN=D:\Project web game java\kemulator-javaemulator\KEmulator_JavaEmulator\jre\bin\javaw.exe
KEMULATOR_DIR=D:\Project web game java\kemulator-javaemulator\KEmulator_JavaEmulator
KEMULATOR_JAR=D:\Project web game java\kemulator-javaemulator\KEmulator_JavaEmulator\KEmulator.jar
KEMULATOR_MAIN_CLASS=emulator.Emulator
KEMULATOR_EXTRA_ARGS=-swt -lwj
GAME_JAR=D:\Project web game java\DragonBoy250.jar
GAME_JAR_SOURCE=D:\Project web game java\DragonBoy250.jar

VNC_HOST=127.0.0.1
VNC_PORT=5900
WORKER_TOKEN=replace-with-worker-token

# Screen-mirror (Giai doan 3): FPS stream + do rong khung gui len web.
# Tran that ~20 FPS (PrintWindow + encode JPEG trong PowerShell). Game J2ME theo luot -> 20 fps muot.
MIRROR_FPS=20
MIRROR_MAX_WIDTH=240

AUTO_RESTART_ON_CRASH=false
MAX_RESTART_ATTEMPTS=3
RESTART_BACKOFF_MS=15000
HEALTH_INTERVAL_MS=5000
